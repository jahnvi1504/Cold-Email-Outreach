generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id              String           @id @default(cuid())
  googleId        String?          @unique
  email           String           @unique
  name            String
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  emailJobs       EmailJob[]
  senders         Sender[]
  slackConnection SlackConnection?
}

model Sender {
  id          String     @id @default(cuid())
  userId      String
  email       String
  displayName String?
  host        String
  port        Int
  username    String
  password    String
  secure      Boolean    @default(false)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs   EmailJob[]

  @@unique([userId, email])
  @@index([userId, active])
}

model EmailJob {
  id                 String      @id @default(cuid())
  userId             String
  senderId           String?
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  processedAt        DateTime?
  status             EmailStatus @default(scheduled)
  hourlyLimit        Int?
  delayBetweenEmails Int         @default(1000)
  attempts           Int         @default(0)
  lastError          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             Sender?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  teamId       String?
  teamName     String?
  accessToken  String
  incomingHook String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
